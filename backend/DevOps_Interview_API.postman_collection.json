        {
            "name": "AI Vision Services",
            "item": [
                {
                    "name": "1. Start Image Analysis",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"image_url\": \"https://example.com/sample.jpg\",\n    \"model_type\": \"object_detection\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "http://localhost:8000/api/vision/analyze-image",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "vision",
                                "analyze-image"
                            ]
                        }
                    }
                },
                {
                    "name": "2. Check Job Status",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:8000/api/vision/status/<REPLACE_WITH_JOB_ID>",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "vision",
                                "status",
                                "<REPLACE_WITH_JOB_ID>"
                            ]
                        }
                    }
                },
                {
                    "name": "3. Get Final Results",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "http://localhost:8000/api/vision/result/<REPLACE_WITH_JOB_ID>",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "8000",
                            "path": [
                                "api",
                                "vision",
                                "result",
                                "<REPLACE_WITH_JOB_ID>"
                            ]
                        }
                    }
                },
